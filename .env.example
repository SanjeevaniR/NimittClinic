#############################################
# Nimitt Clinic — environment configuration
# Copy to `.env.local` and fill in real values.
# Everything prefixed NEXT_PUBLIC_ is exposed to the browser.
#############################################

# ---------- Site ----------
# Absolute origin, no trailing slash. Used for canonical URLs, OG tags, sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Clinic identity ----------
NEXT_PUBLIC_CLINIC_NAME=Nimitt Clinic
NEXT_PUBLIC_CLINIC_TAGLINE=Leading Specialists, Personalized Care

# ---------- Contact ----------
# Display forms; tel: links are derived automatically.
NEXT_PUBLIC_CLINIC_PHONE=+91 70000 00000
NEXT_PUBLIC_CLINIC_EMAIL=contact@nimittclinic.com

# WhatsApp Business number in INTERNATIONAL format, digits only, no + or spaces.
# Example for India: 917000000000
NEXT_PUBLIC_WHATSAPP_NUMBER=917000000000
NEXT_PUBLIC_WHATSAPP_MESSAGE=Hello Nimitt Clinic, I would like to book an appointment.

# ---------- Address ----------
NEXT_PUBLIC_ADDRESS_LINE1=TODO Building name, Floor
NEXT_PUBLIC_ADDRESS_LINE2=TODO Road / Landmark
NEXT_PUBLIC_ADDRESS_CITY=Indore
NEXT_PUBLIC_ADDRESS_STATE=Madhya Pradesh
NEXT_PUBLIC_ADDRESS_POSTAL_CODE=452010
NEXT_PUBLIC_ADDRESS_COUNTRY=IN
NEXT_PUBLIC_GEO_LAT=22.7196
NEXT_PUBLIC_GEO_LNG=75.8577

# Paste the `src` value from Google Maps → Share → Embed a map.
NEXT_PUBLIC_MAP_EMBED_URL=https://www.google.com/maps?q=Indore&output=embed

# ---------- Social (leave blank to hide the icon) ----------
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_X=

# ---------- Online booking (optional) ----------
# External booking URL (Practo, Zocdoc, your own portal). Blank => button points to /contact.
NEXT_PUBLIC_BOOKING_URL=

# ---------- Mail transport ----------
# "smtp" (free with Gmail/Workspace app password) | "resend" | "console" (dev: logs only)
MAIL_TRANSPORT=console

# Where contact-form submissions are delivered. Comma-separate for multiple.
CONTACT_TO_EMAIL=frontdesk@nimittclinic.com
# The From header. With SMTP this must be the authenticated mailbox.
CONTACT_FROM_EMAIL=Nimitt Clinic Website <frontdesk@nimittclinic.com>

# --- MAIL_TRANSPORT=smtp ---
# Gmail / Google Workspace: host smtp.gmail.com, port 465, secure true,
# user = full address, pass = 16-char App Password (myaccount.google.com/apppasswords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=

# --- MAIL_TRANSPORT=resend ---
# Free tier: 3,000 emails/month. Requires a verified sending domain.
RESEND_API_KEY=

# ---------- Anti-abuse ----------
# Max contact-form submissions per IP per window.
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=900
